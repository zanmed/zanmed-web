# --- Database (Prisma Postgres) ---
DATABASE_URL="postgresql://user:password@host:5432/zanmed?sslmode=require"

# --- Auth (better-auth) ---
BETTER_AUTH_SECRET="generate-with-openssl-rand-base64-32"
BETTER_AUTH_URL="http://localhost:3000"

# Seed credentials for the first admin account (used by prisma/seed.ts only)
ADMIN_SEED_EMAIL="admin@zanmed.co.ke"
ADMIN_SEED_PASSWORD="change-me-before-seeding"

# --- Upstash Redis (rate limiting) ---
UPSTASH_REDIS_REST_URL="https://xxxx.upstash.io"
UPSTASH_REDIS_REST_TOKEN="xxxx"

# --- ImageKit (object storage + image optimisation) ---
IMAGEKIT_PUBLIC_KEY="public_xxxx"
IMAGEKIT_PRIVATE_KEY="private_xxxx"
IMAGEKIT_URL_ENDPOINT="https://ik.imagekit.io/your_id"
NEXT_PUBLIC_IMAGEKIT_PUBLIC_KEY="public_xxxx"
NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT="https://ik.imagekit.io/your_id"

# --- Sentry ---
NEXT_PUBLIC_SENTRY_DSN="https://xxxx.ingest.sentry.io/xxxx"
SENTRY_ORG="zanmed-digital-solutions"
SENTRY_PROJECT="zanmed-web"
SENTRY_AUTH_TOKEN="xxxx"

# --- Site ---
NEXT_PUBLIC_SITE_URL="https://zanmed.co.ke"
NEXT_PUBLIC_SITE_NAME="zanmed Digital Solutions"
NEXT_PUBLIC_WHATSAPP_NUMBER="254700000000"
